<%- include('partials/head') %>
<div style="font-family: Archivo, 'Helvetica Neue', Arial, sans-serif; color: #F5F5F4; background: #0A0A0B; color-scheme: dark">

<%- include('partials/header', { active: 'detalle' }) %>

<main style="max-width: 1280px; margin: 0 auto; padding: 28px 24px 96px; display: flex; flex-direction: column; gap: 56px">

<nav aria-label="Ruta" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 14px; color: #A1A1AA">
<a href="/#catalogo" style="color: #D4D4D8; text-decoration: none; display: inline-flex; align-items: center; gap: 6px">
<%- icon.arrowLeft(16) %>
Catálogo
</a>
<span aria-hidden="true">/</span>
<a href="/?tipo=<%= encodeURIComponent(car.tipo) %>#catalogo" style="color: #A1A1AA; text-decoration: none"><%= car.tipo %></a>
<span aria-hidden="true">/</span>
<span aria-current="page" style="color: #F5F5F4"><%= car.titulo %></span>
</nav>

<% if (car.vendido) { %>
<div style="margin-top: -32px; background: #1A0E0D; border: 1px solid #3B1A17; border-radius: 14px; padding: 16px 20px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px; font-size: 15px; color: #F3D6D3">
<span><strong style="color: #FFFFFF">Este auto ya se vendió.</strong> Mirá abajo otros parecidos o escribinos y te avisamos cuando entre uno igual.</span>
<a href="/#catalogo" style="font-weight: 600">Ver catálogo</a>
</div>
<% } %>

<div style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px">

<section aria-label="Fotos" data-gallery style="flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 12px">
<div class="ph" style="position: relative; aspect-ratio: 16 / 10; border-radius: 18px; border: 1px solid #232327; overflow: hidden; display: flex; align-items: center; justify-content: center">
<% if (car.fotos.length) { %>
<img class="cover" data-main src="<%= car.fotos[0].lg %>" srcset="<%= car.fotos[0].md %> 800w, <%= car.fotos[0].lg %> 1600w" sizes="(max-width: 1100px) 100vw, 800px" alt="<%= car.nombreLargo %> — foto 1" width="1600" height="1000" fetchpriority="high">
<span style="position: absolute; right: 18px; top: 16px; padding: 6px 12px; border-radius: 999px; background: rgba(10,10,11,0.85); font-size: 13px; color: #E4E4E7" data-counter>1 / <%= car.fotos.length %></span>
<% if (car.fotos.length > 1) { %>
<button type="button" class="arrow" aria-label="Foto anterior" data-prev style="position: absolute; left: 16px; top: 50%; margin-top: -24px; width: 48px; height: 48px; border-radius: 999px; border: 0; background: rgba(10,10,11,0.85); color: #F5F5F4; display: flex; align-items: center; justify-content: center">
<%- icon.chevronLeft(20) %>
</button>
<button type="button" class="arrow" aria-label="Foto siguiente" data-next style="position: absolute; right: 16px; top: 50%; margin-top: -24px; width: 48px; height: 48px; border-radius: 999px; border: 0; background: rgba(10,10,11,0.85); color: #F5F5F4; display: flex; align-items: center; justify-content: center">
<%- icon.chevronRight(20) %>
</button>
<% } %>
<% } else { %>
<%- icon.car('44%', '#4A4A52', 1.6) %>
<span style="position: absolute; left: 18px; top: 16px; padding: 6px 12px; border-radius: 999px; background: rgba(10,10,11,0.85); font-size: 13px; color: #E4E4E7">Fotos próximamente</span>
<% } %>
<% if (car.reservado) { %><span style="position: absolute; left: 18px; top: 16px; padding: 6px 12px; border-radius: 999px; background: #F5C76B; font-size: 13px; font-weight: 700; color: #2E2410">Reservado</span><% } %>
</div>
<% if (car.fotos.length > 1) { %>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(96px, 100%), 1fr)); gap: 10px">
<% car.fotos.forEach((f, i) => { %>
<button type="button" class="thumb ph" aria-pressed="<%= i === 0 %>" aria-label="Ver foto <%= i + 1 %>" data-thumb data-lg="<%= f.lg %>" data-md="<%= f.md %>" style="aspect-ratio: 4 / 3; border-radius: 10px; padding: 0">
<img src="<%= f.sm %>" alt="" width="400" height="300" loading="lazy" decoding="async">
</button>
<% }) %>
</div>
<% } %>
</section>

<aside aria-label="Precio y contacto" style="flex: 1 1 380px; min-width: 0; background: #111113; border: 1px solid #232327; border-radius: 20px; padding: 28px; display: flex; flex-direction: column; gap: 22px">
<div style="display: flex; flex-wrap: wrap; gap: 8px">
<span style="padding: 6px 12px; border-radius: 999px; border: 1px solid #2E2E33; font-size: 13px; color: #D4D4D8">Ref. <%= car.ref %></span>
<span style="padding: 6px 12px; border-radius: 999px; border: 1px solid #2E2E33; font-size: 13px; color: #D4D4D8; display: inline-flex; align-items: center; gap: 6px">
<%- icon.pin(14, 'currentColor', 1.9) %>
Local <%= car.sede %>
</span>
</div>
<div style="display: flex; flex-direction: column; gap: 4px">
<span style="font-size: 13px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: #A1A1AA"><%= car.marca %></span>
<h1 style="margin: 0; font-size: 40px; line-height: 1.02; font-weight: 800; font-stretch: 115%"><%= car.modelo %><span class="sr-only"> <%= car.version %> <%= car.anio %></span></h1>
<span style="font-size: 17px; color: #B4B4BC"><%= car.version %></span>
</div>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px">
<% for (const r of [['Año', car.anio], ['Kilómetros', car.kmFmt], ['Combustible', car.combustible], ['Transmisión', car.transmision]]) { %>
<div style="background: #0A0A0B; border: 1px solid #222226; border-radius: 12px; padding: 12px 14px; display: flex; flex-direction: column; gap: 2px">
<span style="font-size: 12px; color: #A1A1AA"><%= r[0] %></span>
<span style="font-size: 16px; font-weight: 700"><%= r[1] %></span>
</div>
<% } %>
</div>
<div style="display: flex; flex-direction: column; gap: 2px; padding-top: 6px; border-top: 1px solid #232327">
<span style="font-size: 13px; color: #A1A1AA; margin-top: 14px">Precio contado</span>
<span style="font-size: clamp(34px, 10vw, 44px); line-height: 1.05; font-weight: 800; font-stretch: 115%; white-space: nowrap"><%= car.precioFmt %></span>
</div>
<% if (car.financiable && !car.vendido) { %>
<div style="background: #0A0A0B; border: 1px solid #3B1A17; border-radius: 14px; padding: 16px 18px; display: flex; flex-direction: column; gap: 8px">
<span style="font-size: 15px; font-weight: 700; color: #FF3B30">Financiación propia</span>
<span style="font-size: 15px; line-height: 1.5; color: #E4E4E7">Entregás <strong style="color: #FFFFFF"><%= car.entregaFmt %></strong> (50%) y el saldo en hasta 36 cuotas fijas.</span>
<span style="font-size: 14px; line-height: 1.5; color: #A1A1AA">También financiamos hasta el 100%. Consultá el valor de la cuota.</span>
</div>
<% } %>
<% if (!car.vendido) { %>
<div style="display: flex; flex-direction: column; gap: 10px">
<a class="btn-red" href="<%= car.wa.consulta %>" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; gap: 10px; height: 54px; border-radius: 999px; font-size: 16px; font-weight: 700">
<%- icon.wa(20) %>
Me interesa este auto
</a>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px">
<a class="btn-ghost" href="<%= car.wa.visita %>" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; height: 48px; border-radius: 999px; border: 1px solid #3A3A40; font-size: 15px; font-weight: 600">Agendar visita</a>
<% if (car.financiable) { %>
<a class="btn-ghost" href="<%= car.wa.financiar %>" target="_blank" rel="noopener" style="display: flex; align-items: center; justify-content: center; height: 48px; border-radius: 999px; border: 1px solid #3A3A40; font-size: 15px; font-weight: 600">Pedir cuotas</a>
<% } %>
</div>
<span style="font-size: 13px; line-height: 1.45; color: #8A8A93; text-align: center">Se abre WhatsApp con el mensaje y el link de este auto ya escritos.</span>
</div>
<% } %>
<p style="margin: 0; display: flex; gap: 8px; font-size: 13px; line-height: 1.45; color: #A1A1AA">
<%- icon.warning(16, 'flex-shrink: 0; margin-top: 1px') %>
Solo atendemos desde el <%= site.whatsapp.display %>. Nunca pedimos señas por otros números.
</p>
</aside>
</div>

<div style="display: flex; flex-wrap: wrap; align-items: flex-start; gap: 40px">
<div style="flex: 999 1 600px; min-width: 0; display: flex; flex-direction: column; gap: 48px">

<section aria-labelledby="ficha" style="display: flex; flex-direction: column; gap: 20px">
<h2 id="ficha" style="margin: 0; font-size: 28px; font-weight: 800; font-stretch: 112%">Ficha técnica</h2>
<dl style="margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); border-top: 1px solid #232327">
<% for (const s of car.ficha) { %>
<div style="display: flex; justify-content: space-between; gap: 16px; padding: 14px 16px 14px 0; border-bottom: 1px solid #232327; font-size: 15px">
<dt style="color: #A1A1AA"><%= s.label %></dt>
<dd style="margin: 0; font-weight: 600; text-align: right"><%= s.value %></dd>
</div>
<% } %>
</dl>
</section>

<% if (car.equipamiento.length) { %>
<section aria-labelledby="equip" style="display: flex; flex-direction: column; gap: 20px">
<h2 id="equip" style="margin: 0; font-size: 28px; font-weight: 800; font-stretch: 112%">Equipamiento</h2>
<ul style="margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr)); gap: 12px 24px">
<% for (const e of car.equipamiento) { %>
<li style="display: flex; align-items: flex-start; gap: 10px; font-size: 15px; line-height: 1.4; color: #E4E4E7">
<%- icon.check(18) %>
<%= e %>
</li>
<% } %>
</ul>
</section>
<% } %>

<% if (car.descripcion) { %>
<section aria-labelledby="desc" style="display: flex; flex-direction: column; gap: 16px">
<h2 id="desc" style="margin: 0; font-size: 28px; font-weight: 800; font-stretch: 112%">Comentarios del vendedor</h2>
<p style="margin: 0; max-width: 720px; font-size: 17px; line-height: 1.65; color: #C9C9CF; white-space: pre-line"><%= car.descripcion %></p>
</section>
<% } %>
</div>

<aside style="flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 16px">
<% if (car.estadoDoc.length) { %>
<section aria-labelledby="estado" style="background: #111113; border: 1px solid #232327; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 14px">
<h2 id="estado" style="margin: 0; font-size: 20px; font-weight: 800; font-stretch: 110%">Estado y documentación</h2>
<dl style="margin: 0; display: flex; flex-direction: column">
<% for (const s of car.estadoDoc) { %>
<div style="display: flex; justify-content: space-between; gap: 16px; padding: 12px 0; border-bottom: 1px solid #232327; font-size: 15px">
<dt style="color: #A1A1AA"><%= s.label %></dt>
<dd style="margin: 0; font-weight: 600; text-align: right"><%= s.value %></dd>
</div>
<% } %>
</dl>
</section>
<% } %>
<% if (car.sedeInfo) { const sede = car.sedeInfo; const mapsQ = encodeURIComponent(sede.mapsQuery); %>
<section aria-labelledby="ubic" style="background: #111113; border: 1px solid #232327; border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<h2 id="ubic" style="margin: 0; font-size: 20px; font-weight: 800; font-stretch: 110%">Dónde verlo</h2>
<div class="ph" style="height: 140px; border-radius: 12px; border: 1px solid #232327; overflow: hidden; display: flex; align-items: center; justify-content: center; font-size: 13px; color: #9A9AA3">
<iframe title="Mapa del local <%= sede.nombre %>" src="https://www.google.com/maps?q=<%= mapsQ %>&output=embed" loading="lazy" referrerpolicy="no-referrer-when-downgrade" style="width: 100%; height: 100%; border: 0; filter: grayscale(0.3) invert(0.9) hue-rotate(180deg)"></iframe>
</div>
<span style="font-size: 16px; font-weight: 700">Local <%= sede.nombre %></span>
<span style="font-size: 15px; color: #A1A1AA"><%= sede.direccion %> · <%= sede.horario %></span>
<a href="https://www.google.com/maps/search/?api=1&query=<%= mapsQ %>" target="_blank" rel="noopener" style="font-size: 15px; font-weight: 600">Cómo llegar</a>
</section>
<% } %>
</aside>
</div>

<% if (similares.length) { %>
<section aria-labelledby="similares" style="display: flex; flex-direction: column; gap: 24px; padding-top: 16px; border-top: 1px solid #1E1E22">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 12px; padding-top: 32px">
<h2 id="similares" style="margin: 0; font-size: 28px; font-weight: 800; font-stretch: 112%">También te pueden interesar</h2>
<a href="/#catalogo" style="font-size: 15px; font-weight: 600">Ver todo el catálogo</a>
</div>
<div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 24px">
<% for (const c of similares) { %>
<a class="card" href="<%= c.url %>" style="display: flex; flex-direction: column; background: #131315; border: 1px solid #232327; border-radius: 16px; overflow: hidden; text-decoration: none; color: #F5F5F4">
<div class="ph" style="position: relative; aspect-ratio: 16 / 9; display: flex; align-items: center; justify-content: center">
<% if (c.cover) { %>
<img class="cover" src="<%= c.cover.md %>" srcset="<%= c.cover.sm %> 400w, <%= c.cover.md %> 800w" sizes="(max-width: 640px) 100vw, 400px" alt="<%= c.nombreLargo %>" width="800" height="450" loading="lazy" decoding="async">
<% } else { %>
<%- icon.car('40%') %>
<% } %>
</div>
<div style="padding: 16px 18px 18px; display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; flex-direction: column; gap: 2px">
<span style="font-size: 18px; font-weight: 700"><%= c.marca %> <%= c.modelo %></span>
<span style="font-size: 14px; color: #A1A1AA"><%= [c.version, c.anio, c.kmFmt].filter(Boolean).join(' · ') %></span>
</div>
<span style="font-size: 22px; font-weight: 800; font-stretch: 112%"><%= c.precioFmt %></span>
</div>
</a>
<% } %>
</div>
</section>
<% } %>
</main>

<%- include('partials/footer-small') %>
</div>
<script src="/js/galeria.js?v=<%= assetVersion %>" defer></script>
</body>
</html>

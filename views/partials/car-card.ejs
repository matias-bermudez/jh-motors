<a class="card" href="<%= car.url %>" data-car
  data-marca="<%= car.marca %>" data-comb="<%= car.combustible %>" data-caja="<%= car.transmision %>" data-tipo="<%= car.tipo %>"
  data-precio="<%= car.precio %>" data-km="<%= car.km %>" data-anio="<%= car.anio %>" data-orden="<%= index %>"
  data-q="<%= (car.marca + ' ' + car.modelo + ' ' + car.version).toLowerCase() %>"
  style="display: flex; flex-direction: column; background: #131315; border: 1px solid #232327; border-radius: 16px; overflow: hidden; text-decoration: none; color: #F5F5F4">
<div class="ph" style="position: relative; aspect-ratio: 16 / 10; display: flex; align-items: center; justify-content: center">
<% if (car.cover) { %>
<img class="cover" src="<%= car.cover.md %>" srcset="<%= car.cover.sm %> 400w, <%= car.cover.md %> 800w" sizes="(max-width: 640px) 100vw, 400px" alt="<%= car.nombreLargo %>" width="800" height="500" loading="<%= index < 4 ? 'eager' : 'lazy' %>" decoding="async">
<% } else { %>
<%- icon.car('46%') %>
<% } %>
<div style="position: absolute; top: 12px; left: 12px; right: 12px; display: flex; justify-content: space-between; gap: 8px">
<div style="display: flex; gap: 6px">
<span style="padding: 5px 10px; border-radius: 999px; background: rgba(10,10,11,0.82); font-size: 12px; font-weight: 600; color: #E4E4E7"><%= car.tipo %></span>
<% if (car.electrico) { %><span style="padding: 5px 10px; border-radius: 999px; background: #E7F0FB; font-size: 12px; font-weight: 700; color: #123A66">Eléctrico</span><% } %>
<% if (car.reservado) { %><span style="padding: 5px 10px; border-radius: 999px; background: #F5C76B; font-size: 12px; font-weight: 700; color: #2E2410">Reservado</span><% } %>
</div>
<span style="padding: 5px 10px; border-radius: 999px; background: rgba(10,10,11,0.82); font-size: 12px; color: #B4B4BC">Ref. <%= car.ref %></span>
</div>
</div>
<div style="padding: 18px 18px 20px; display: flex; flex-direction: column; gap: 16px; flex-grow: 1">
<div style="display: flex; flex-direction: column; gap: 3px">
<span style="font-size: 12px; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: #A1A1AA"><%= car.marca %></span>
<h3 style="margin: 0; font-size: 21px; line-height: 1.15; font-weight: 700; font-stretch: 108%"><%= car.modelo %></h3>
<span style="font-size: 14px; color: #A1A1AA"><%= car.version %></span>
</div>
<div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px 12px; font-size: 14px; color: #D4D4D8">
<span style="display: flex; align-items: center; gap: 8px"><%- icon.calendar() %><%= car.anio %></span>
<span style="display: flex; align-items: center; gap: 8px"><%- icon.gauge() %><%= car.kmFmt %></span>
<span style="display: flex; align-items: center; gap: 8px"><%- icon.fuel() %><%= car.combustible %></span>
<span style="display: flex; align-items: center; gap: 8px"><%- icon.gearbox() %><%= car.transmision %></span>
<span style="display: flex; align-items: center; gap: 8px"><%- icon.engine() %><%= car.motor || '—' %></span>
<span style="display: flex; align-items: center; gap: 8px"><%- icon.pin() %><%= car.sede %></span>
</div>
<div style="margin-top: auto; padding-top: 16px; border-top: 1px solid #232327; display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 8px 12px">
<div style="display: flex; flex-direction: column; gap: 2px">
<span style="font-size: 12px; color: #A1A1AA">Precio contado</span>
<span style="font-size: 25px; line-height: 1.1; font-weight: 800; font-stretch: 112%; white-space: nowrap"><%= car.precioFmt %></span>
</div>
<span style="display: inline-flex; align-items: center; gap: 6px; font-size: 14px; font-weight: 600; color: #FF3B30; white-space: nowrap">Ver detalle<%- icon.arrowRight(16) %></span>
</div>
</div>
</a>

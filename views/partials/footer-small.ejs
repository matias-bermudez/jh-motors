<footer style="background: #070708; border-top: 1px solid #1E1E22">
<div style="max-width: 1280px; margin: 0 auto; padding: 32px 24px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; font-size: 14px; color: #8A8A93">
<a href="/" aria-label="JH Motors, inicio" style="display: flex; align-items: baseline; gap: 6px; text-decoration: none">
<span style="font-family: 'Bodoni Moda', Didot, 'Times New Roman', serif; font-weight: 700; font-size: 24px; line-height: 1; color: #FFFFFF">JH</span>
<span style="font-stretch: 115%; font-weight: 800; font-size: 15px; line-height: 1; letter-spacing: 0.03em; color: #FF3B30">MOTORS</span>
</a>
<span><%= Object.keys(site.sedes).join(' · ') %> · WhatsApp <%= site.whatsapp.display %></span>
<% if (locals.footerInstagram) { %>
<a href="<%= site.instagram.url %>" target="_blank" rel="noopener">Instagram @<%= site.instagram.user %></a>
<% } else { %>
<span>Precios en dólares, sujetos a cambio sin previo aviso.</span>
<% } %>
</div>
</footer>

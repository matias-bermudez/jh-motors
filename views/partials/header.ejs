<header class="site-header" style="position: sticky; top: 0; z-index: 10; background: rgba(10,10,11,0.94); border-bottom: 1px solid #1F1F23; backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px)">
<div style="max-width: 1280px; margin: 0 auto; padding: 12px 24px; min-height: 48px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 32px">
<a href="/" aria-label="JH Motors, inicio" style="display: flex; align-items: baseline; gap: 7px; text-decoration: none">
<span style="font-family: 'Bodoni Moda', Didot, 'Times New Roman', serif; font-weight: 700; font-size: 32px; line-height: 1; color: #FFFFFF">JH</span>
<span style="font-family: Archivo, Arial, sans-serif; font-stretch: 115%; font-weight: 800; font-size: 19px; line-height: 1; letter-spacing: 0.03em; color: #FF3B30">MOTORS</span>
</a>
<nav aria-label="Principal" style="display: flex; flex-wrap: wrap; align-items: center; gap: 8px 28px; font-size: 15px; font-weight: 500">
<% const navHome = locals.isHome ? '' : '/'; %>
<a class="nav" href="<%= navHome %>#catalogo"<% if (active === 'catalogo') { %> aria-current="page"<% } %><% if (active === 'catalogo' || active === 'detalle') { %> style="color: #FFFFFF"<% } %>>Catálogo</a>
<a class="nav" href="<%= navHome %>#financiacion">Financiación</a>
<a class="nav" href="/vende-tu-auto"<% if (active === 'vender') { %> aria-current="page" style="color: #FFFFFF"<% } %>>Vendé tu auto</a>
<a class="nav" href="<%= navHome %>#contacto">Contacto</a>
</nav>
<a class="btn-red wa-top" href="<%= site.whatsapp.link() %>" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp al <%= site.whatsapp.display %>" style="display: inline-flex; align-items: center; gap: 9px; height: 44px; padding: 0 18px; border-radius: 999px; font-size: 15px; font-weight: 700">
<%- icon.wa(18) %>
<%= site.whatsapp.display %>
</a>
</div>
</header>

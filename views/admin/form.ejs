<%- include('_top', { title: isNew ? 'Cargar auto' : 'Editar ' + car.marca + ' ' + car.modelo, logged: true }) %>
<main class="adm-wrap">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px">
<div style="display: flex; flex-direction: column; gap: 6px">
<a href="/admin" style="font-size: 14px; text-decoration: none">← Volver a la lista</a>
<h1><%= isNew ? 'Cargar auto nuevo' : car.marca + ' ' + car.modelo + ' ' + car.anio %></h1>
<% if (!isNew) { %><span style="font-size: 15px; color: #A1A1AA">Ref. <%= car.ref %> · <a href="<%= car.url %>" target="_blank" rel="noopener">Ver publicación</a></span><% } %>
</div>
</div>

<% if (msg) { %><div class="adm-msg ok"><%= msg %></div><% } %>
<% if (errors.length) { %><div class="adm-msg err"><% for (const e of errors) { %><div><%= e %></div><% } %></div><% } %>

<form method="post" action="<%= isNew ? '/admin/autos' : '/admin/autos/' + car.id %>" enctype="multipart/form-data" id="car-form" style="display: flex; flex-direction: column; gap: 24px">

<fieldset class="adm-box">
<legend>Datos del auto</legend>
<div class="adm-grid">
<label class="adm-field">Marca *
<input class="in" name="marca" list="marcas" required value="<%= car.marca %>" placeholder="Ej.: Volkswagen">
<datalist id="marcas"><% for (const m of marcas) { %><option value="<%= m %>"><% } %></datalist>
</label>
<label class="adm-field">Modelo *<input class="in" name="modelo" required value="<%= car.modelo %>" placeholder="Ej.: T-Cross"></label>
<label class="adm-field">Versión<input class="in" name="version" value="<%= car.version %>" placeholder="Ej.: Highline 1.4 TSI"></label>
<label class="adm-field">Año *<input class="in" name="anio" type="number" inputmode="numeric" required min="1950" max="<%= new Date().getFullYear() + 1 %>" value="<%= car.anio %>"></label>
<label class="adm-field">Kilómetros<input class="in" name="km" type="number" inputmode="numeric" min="0" value="<%= car.km %>" placeholder="Ej.: 32000"></label>
<label class="adm-field">Carrocería
<select class="in" name="tipo"><% for (const o of options.tipos) { %><option<%= o === car.tipo ? ' selected' : '' %>><%= o %></option><% } %></select>
</label>
<label class="adm-field">Combustible
<select class="in" name="combustible"><% for (const o of options.combustibles) { %><option<%= o === car.combustible ? ' selected' : '' %>><%= o %></option><% } %></select>
</label>
<label class="adm-field">Transmisión
<select class="in" name="transmision"><% for (const o of options.transmisiones) { %><option<%= o === car.transmision ? ' selected' : '' %>><%= o %></option><% } %></select>
</label>
<label class="adm-field">Cantidad de marchas<input class="in" name="marchas" type="number" inputmode="numeric" min="1" max="10" value="<%= car.marchas %>" placeholder="Ej.: 6"></label>
<label class="adm-field">Motor<input class="in" name="motor" value="<%= car.motor %>" placeholder="Ej.: 1.4 TSI turbo"></label>
<label class="adm-field">Potencia<input class="in" name="potencia" value="<%= car.potencia %>" placeholder="Ej.: 150 CV"></label>
<label class="adm-field">Tracción
<select class="in" name="traccion"><option value="">—</option><% for (const o of options.tracciones) { %><option<%= o === car.traccion ? ' selected' : '' %>><%= o %></option><% } %></select>
</label>
<label class="adm-field">Puertas<input class="in" name="puertas" type="number" inputmode="numeric" min="2" max="5" value="<%= car.puertas %>" placeholder="Ej.: 5"></label>
<label class="adm-field">Color<input class="in" name="color" value="<%= car.color %>" placeholder="Ej.: Blanco"></label>
<label class="adm-field">Empadronado en
<select class="in" name="padron"><option value="">—</option><% for (const o of options.departamentos) { %><option<%= o === car.padron ? ' selected' : '' %>><%= o %></option><% } %></select>
</label>
</div>
</fieldset>

<fieldset class="adm-box">
<legend>Precio y publicación</legend>
<div class="adm-grid">
<label class="adm-field">Precio contado *<input class="in" name="precio" type="number" inputmode="numeric" min="0" required value="<%= car.precio %>" placeholder="Ej.: 29900"></label>
<label class="adm-field">Moneda
<select class="in" name="moneda"><% for (const o of options.monedas) { %><option value="<%= o %>"<%= o === car.moneda ? ' selected' : '' %>><%= o === 'USD' ? 'Dólares (USD)' : 'Pesos uruguayos ($U)' %></option><% } %></select>
</label>
<label class="adm-field">Local
<select class="in" name="sede"><% for (const s of sedes) { %><option<%= s === car.sede ? ' selected' : '' %>><%= s %></option><% } %></select>
</label>
<label class="adm-field">Estado de la publicación
<select class="in" name="estado"><% for (const o of options.estados) { %><option value="<%= o %>"<%= o === car.estado ? ' selected' : '' %>><%= o[0].toUpperCase() + o.slice(1) %></option><% } %></select>
<small>Los vendidos no aparecen en el catálogo.</small>
</label>
</div>
<div style="display: flex; flex-wrap: wrap; gap: 12px 28px">
<label class="adm-check"><input type="checkbox" name="financiable" value="1"<%= car.financiable ? ' checked' : '' %>> Se puede financiar</label>
<label class="adm-check"><input type="checkbox" name="permuta" value="1"<%= car.permuta ? ' checked' : '' %>> Acepta permuta</label>
<label class="adm-check"><input type="checkbox" name="destacado" value="1"<%= car.destacado ? ' checked' : '' %>> Destacado (foto grande en el inicio)</label>
</div>
</fieldset>

<fieldset class="adm-box">
<legend>Fotos</legend>
<p style="margin: 0; font-size: 14px; color: #A1A1AA">La primera es la portada. Usá las flechas para ordenarlas. Podés subir varias juntas (JPG, PNG o WEBP); se achican solas para que la web cargue rápido.</p>
<div class="adm-photos" id="photos">
<% for (const f of car.fotos) { %>
<div class="adm-photo" data-id="<%= f.id %>">
<img src="<%= f.sm %>" alt="">
<span class="tag" hidden>Portada</span>
<div class="tools">
<button type="button" data-act="left" aria-label="Mover antes">←</button>
<button type="button" data-act="right" aria-label="Mover después">→</button>
<button type="button" data-act="del" aria-label="Quitar foto">✕</button>
</div>
</div>
<% } %>
</div>
<input type="hidden" name="photo_order" id="photo_order">
<input type="hidden" name="photo_delete" id="photo_delete">
<label class="adm-field">Agregar fotos
<input class="in" type="file" name="fotos" id="fotos" accept="image/jpeg,image/png,image/webp,image/*" multiple style="height: auto; padding: 12px 14px">
</label>
<div class="adm-photos" id="new-photos"></div>
</fieldset>

<fieldset class="adm-box">
<legend>Estado y documentación</legend>
<div class="adm-grid">
<label class="adm-field">Dueños anteriores<input class="in" name="duenos" value="<%= car.duenos %>" placeholder="Ej.: 1"></label>
<label class="adm-field">Service<input class="in" name="service" value="<%= car.service %>" placeholder="Ej.: Al día, en agencia"></label>
<label class="adm-field">Documentación<input class="in" name="documentacion" value="<%= car.documentacion %>" placeholder="Ej.: Al día, libre de deudas"></label>
<label class="adm-field">Llaves<input class="in" name="llaves" value="<%= car.llaves %>" placeholder="Ej.: 2 juegos"></label>
<label class="adm-field">Garantía<input class="in" name="garantia" value="<%= car.garantia %>" placeholder="Ej.: 3 meses motor y caja"></label>
</div>
</fieldset>

<fieldset class="adm-box">
<legend>Equipamiento</legend>
<div class="adm-checks">
<% for (const e of options.equipamiento) { %>
<label class="adm-check"><input type="checkbox" name="equipamiento" value="<%= e %>"<%= car.equipamiento.includes(e) ? ' checked' : '' %>> <%= e %></label>
<% } %>
</div>
<label class="adm-field">Otros (uno por renglón)
<textarea class="in" name="equipamiento_extra" rows="4" placeholder="Ej.: Llantas de aleación 17 pulgadas"><%= car.equipamiento.filter((e) => !options.equipamiento.includes(e)).join('\n') %></textarea>
</label>
</fieldset>

<fieldset class="adm-box">
<legend>Comentarios del vendedor</legend>
<label class="adm-field"><span class="sr-only">Comentarios</span>
<textarea class="in" name="descripcion" rows="5" placeholder="Estado general, por qué es una buena compra, detalles a tener en cuenta..."><%= car.descripcion %></textarea>
</label>
</fieldset>

<div style="display: flex; flex-wrap: wrap; gap: 12px; position: sticky; bottom: 0; padding: 16px 0; background: linear-gradient(transparent, #0A0A0B 30%)">
<button class="adm-btn btn-red" type="submit" id="guardar"><%= isNew ? 'Publicar auto' : 'Guardar cambios' %></button>
<a class="adm-btn ghost" href="/admin">Cancelar</a>
</div>
</form>

<% if (!isNew) { %>
<form method="post" action="/admin/autos/<%= car.id %>/eliminar" class="adm-box" style="border-color: #3B1A17" onsubmit="return confirm('¿Eliminar este auto y sus fotos para siempre? Si se vendió, mejor marcalo como vendido.')">
<h2>Eliminar publicación</h2>
<p style="margin: 0; font-size: 14px; color: #A1A1AA">Borra el auto y sus fotos. Si se vendió, mejor marcalo como <strong>vendido</strong>: el link sigue funcionando para quien lo tenga guardado.</p>
<div><button class="adm-btn danger" type="submit">Eliminar auto</button></div>
</form>
<% } %>
</main>
</div>
<script src="/js/admin.js?v=<%= assetVersion %>" defer></script>
</body>
</html>

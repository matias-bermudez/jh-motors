<%- include('_top', { title: 'Ingresar' }) %>
<main class="adm-wrap" style="max-width: 440px; padding-top: 72px">
<h1>Ingresar</h1>
<% if (!enabled) { %>
<div class="adm-msg err">El panel está desactivado: falta definir <strong>ADMIN_PASSWORD</strong> en el archivo <code>.env</code> del servidor.</div>
<% } %>
<% if (error) { %><div class="adm-msg err"><%= error %></div><% } %>
<form method="post" action="/admin/login" class="adm-box">
<label class="adm-field">Usuario
<input class="in" name="user" autocomplete="username" required autofocus>
</label>
<label class="adm-field">Contraseña
<input class="in" name="pass" type="password" autocomplete="current-password" required>
</label>
<button class="adm-btn btn-red" type="submit">Entrar</button>
</form>
</main>
</div>
</body>
</html>

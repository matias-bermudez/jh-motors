<%- include('_top', { title: 'Autos', logged: true }) %>
<main class="adm-wrap">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px">
<div style="display: flex; flex-direction: column; gap: 6px">
<h1>Autos publicados</h1>
<span style="font-size: 15px; color: #A1A1AA"><%= counts.disponible %> disponibles · <%= counts.reservado %> reservados · <%= counts.vendido %> vendidos</span>
</div>
<a class="adm-btn btn-red" href="/admin/autos/nuevo">+ Cargar auto nuevo</a>
</div>

<% if (msg) { %><div class="adm-msg ok"><%= msg %></div><% } %>

<% if (!cars.length) { %>
<div class="adm-box" style="align-items: center; text-align: center; padding: 56px 24px">
<h2>Todavía no hay autos</h2>
<p style="margin: 0; color: #A1A1AA">Cargá el primero y aparece en el catálogo al instante.</p>
<a class="adm-btn btn-red" href="/admin/autos/nuevo">Cargar auto</a>
</div>
<% } else { %>
<table class="adm-table">
<thead><tr><th>Foto</th><th>Auto</th><th>Precio</th><th>Estado</th><th>Acciones</th></tr></thead>
<tbody>
<% for (const c of cars) { %>
<tr>
<td><% if (c.cover) { %><img src="<%= c.cover.sm %>" alt="" loading="lazy"><% } else { %><div class="ph"></div><% } %></td>
<td>
<a href="/admin/autos/<%= c.id %>" style="color: #F5F5F4; font-weight: 700; text-decoration: none"><%= c.marca %> <%= c.modelo %> <%= c.anio %></a>
<div style="font-size: 13px; color: #A1A1AA"><%= c.ref %> · <%= c.version %> · <%= c.kmFmt %> · <%= c.sede %><%= c.destacado ? ' · ★ Destacado' : '' %> · <%= c.fotos.length %> fotos</div>
</td>
<td style="font-weight: 700; white-space: nowrap"><%= c.precioFmt %></td>
<td><span class="adm-badge <%= c.estado %>"><%= c.estado %></span></td>
<td>
<div style="display: flex; flex-wrap: wrap; gap: 6px">
<a class="adm-btn ghost small" href="/admin/autos/<%= c.id %>">Editar</a>
<a class="adm-btn ghost small" href="<%= c.url %>" target="_blank" rel="noopener">Ver</a>
<% for (const [estado, label] of [['disponible', 'Disponible'], ['reservado', 'Reservar'], ['vendido', 'Vendido']]) { if (estado === c.estado) continue; %>
<form method="post" action="/admin/autos/<%= c.id %>/estado" style="margin: 0"><input type="hidden" name="estado" value="<%= estado %>"><button class="adm-btn ghost small" type="submit"><%= label %></button></form>
<% } %>
</div>
</td>
</tr>
<% } %>
</tbody>
</table>
<% } %>
</main>
</div>
</body>
</html>

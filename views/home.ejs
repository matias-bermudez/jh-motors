<%- include('partials/head') %>
<div style="font-family: Archivo, 'Helvetica Neue', Arial, sans-serif; color: #F5F5F4; background: #0A0A0B; color-scheme: dark">

<% if (site.showAviso) { %>
<div style="background: #1A0E0D; border-bottom: 1px solid #3B1A17">
<div style="max-width: 1280px; margin: 0 auto; padding: 10px 24px; display: flex; align-items: center; justify-content: center; gap: 10px; font-size: 14px; line-height: 1.4; color: #F3D6D3; text-align: center">
<%- icon.warning(18) %>
<p style="margin: 0">Nuestro único WhatsApp oficial es el <strong style="color: #FFFFFF"><%= site.whatsapp.display %></strong>. Si te escriben desde otro número en nombre de JH Motors, no respondas.</p>
</div>
</div>
<% } %>

<%- include('partials/header', { active: 'catalogo', isHome: true }) %>

<main>
<section style="max-width: 1280px; margin: 0 auto; padding: 72px 24px 64px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
<div style="flex: 1 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #FF3B30">Ventas · Consignaciones · Financiación</p>
<h1 style="margin: 0; font-size: clamp(40px, 5.4vw, 74px); line-height: 0.98; font-weight: 800; font-stretch: 118%; letter-spacing: -0.015em; text-wrap: balance"><%= site.stockText %></h1>
<p style="margin: 0; max-width: 540px; font-size: 18px; line-height: 1.55; color: #B4B4BC; text-wrap: pretty">Ventas y consignaciones en Toledo y Atlántida. Financiamos hasta el 100%, o con financiación propia en hasta 36 cuotas fijas entregando el 50%.</p>
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<a class="btn-red" href="#catalogo" style="display: inline-flex; align-items: center; gap: 10px; height: 52px; padding: 0 26px; border-radius: 999px; font-size: 16px; font-weight: 700">
Ver catálogo
<%- icon.arrowRight(18) %>
</a>
<a class="btn-ghost" href="/vende-tu-auto" style="display: inline-flex; align-items: center; height: 52px; padding: 0 26px; border-radius: 999px; border: 1px solid #3A3A40; font-size: 16px; font-weight: 600">Vendé tu auto</a>
</div>
</div>
<% if (destacado && destacado.cover) { %>
<a class="ph" href="<%= destacado.url %>" style="flex: 1 1 520px; min-width: 0; aspect-ratio: 4 / 3; border-radius: 20px; border: 1px solid #232327; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden; text-decoration: none">
<img class="cover" src="<%= destacado.cover.lg %>" srcset="<%= destacado.cover.md %> 800w, <%= destacado.cover.lg %> 1600w" sizes="(max-width: 1100px) 100vw, 620px" alt="<%= destacado.nombreLargo %>" width="1600" height="1200" fetchpriority="high">
<span style="position: absolute; left: 20px; bottom: 16px; display: flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; background: rgba(10,10,11,0.85); font-size: 13px; color: #E4E4E7">
<%- icon.camera(16) %>
Destacado: <%= destacado.titulo %> · <%= destacado.precioFmt %>
</span>
</a>
<% } else { %>
<div class="ph" style="flex: 1 1 520px; min-width: 0; aspect-ratio: 4 / 3; border-radius: 20px; border: 1px solid #232327; position: relative; display: flex; align-items: center; justify-content: center; overflow: hidden">
<%- icon.carSplit() %>
</div>
<% } %>
</section>

<section aria-label="JH Motors en números" style="background: #0E0E10; border-top: 1px solid #1E1E22; border-bottom: 1px solid #1E1E22">
<div style="max-width: 1280px; margin: 0 auto; padding: 28px 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 24px">
<% for (const s of site.stats) { %>
<div style="display: flex; flex-direction: column; gap: 4px"><span style="font-size: 32px; font-weight: 800; font-stretch: 115%; line-height: 1.1"><%= s.value %></span><span style="font-size: 14px; color: #A1A1AA"><%= s.label %></span></div>
<% } %>
</div>
</section>

<section id="catalogo" style="max-width: 1280px; margin: 0 auto; padding: 80px 24px 96px; display: flex; flex-direction: column; gap: 28px; scroll-margin-top: 70px">
<div style="display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px">
<div style="display: flex; flex-direction: column; gap: 6px">
<h2 style="margin: 0; font-size: 44px; line-height: 1; font-weight: 800; font-stretch: 115%">Catálogo</h2>
<p id="count" style="margin: 0; font-size: 16px; color: #A1A1AA" aria-live="polite"><%= cars.length === 1 ? '1 auto disponible' : cars.length + ' autos disponibles' %></p>
</div>
<div style="display: flex; align-items: center; gap: 10px">
<label for="orden" style="font-size: 14px; color: #A1A1AA">Ordenar por</label>
<select id="orden" class="in" style="height: 44px; padding: 0 12px; font-size: 15px">
<option value="recientes">Más recientes</option>
<option value="precioAsc">Menor precio</option>
<option value="precioDesc">Mayor precio</option>
<option value="km">Menos kilómetros</option>
<option value="anio">Año más nuevo</option>
</select>
</div>
</div>

<div style="background: #111113; border: 1px solid #222226; border-radius: 16px; padding: 18px; display: flex; flex-direction: column; gap: 18px">
<div style="display: flex; flex-wrap: wrap; gap: 12px">
<div style="flex: 2 1 280px; display: flex; flex-direction: column; gap: 6px">
<label for="buscar" style="font-size: 13px; color: #A1A1AA">Buscar</label>
<div style="position: relative">
<%- icon.search() %>
<input id="buscar" class="in" type="search" placeholder="Marca, modelo o versión" autocomplete="off" style="width: 100%; box-sizing: border-box; height: 44px; padding: 0 14px 0 42px; font-size: 15px">
</div>
</div>
<div style="flex: 1 1 160px; display: flex; flex-direction: column; gap: 6px">
<label for="marca" style="font-size: 13px; color: #A1A1AA">Marca</label>
<select id="marca" class="in" style="height: 44px; padding: 0 12px; font-size: 15px">
<option value="Todas">Todas</option>
<% for (const v of filtros.marcas) { %><option value="<%= v %>"><%= v %></option><% } %>
</select>
</div>
<div style="flex: 1 1 160px; display: flex; flex-direction: column; gap: 6px">
<label for="comb" style="font-size: 13px; color: #A1A1AA">Combustible</label>
<select id="comb" class="in" style="height: 44px; padding: 0 12px; font-size: 15px">
<option value="Todos">Todos</option>
<% for (const v of filtros.combs) { %><option value="<%= v %>"><%= v %></option><% } %>
</select>
</div>
<div style="flex: 1 1 160px; display: flex; flex-direction: column; gap: 6px">
<label for="caja" style="font-size: 13px; color: #A1A1AA">Transmisión</label>
<select id="caja" class="in" style="height: 44px; padding: 0 12px; font-size: 15px">
<option value="Todas">Todas</option>
<% for (const v of filtros.cajas) { %><option value="<%= v %>"><%= v %></option><% } %>
</select>
</div>
</div>
<div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px">
<div id="tipos" role="group" aria-label="Tipo de vehículo" style="display: flex; flex-wrap: wrap; gap: 8px">
<% for (const t of ['Todos'].concat(filtros.tipos)) { %>
<button type="button" class="chip toggle" data-tipo="<%= t %>" aria-pressed="<%= t === 'Todos' %>" style="height: 44px; padding: 0 18px; border-radius: 999px; font-size: 15px"><%= t %></button>
<% } %>
</div>
<button type="button" class="chip" data-limpiar style="height: 44px; padding: 0 6px; border: 0; background: transparent; color: #FF3B30; font-size: 15px; font-weight: 600; text-decoration: underline; text-underline-offset: 3px">Limpiar filtros</button>
</div>
</div>

<div id="grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 24px"<% if (!cars.length) { %> hidden<% } %>>
<% cars.forEach((car, index) => { %><%- include('partials/car-card', { car, index }) %><% }) %>
</div>

<div id="empty" style="border: 1px dashed #2E2E33; border-radius: 16px; padding: 56px 24px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center"<% if (cars.length) { %> hidden<% } %>>
<p style="margin: 0; font-size: 20px; font-weight: 700">No encontramos autos con esos filtros</p>
<p style="margin: 0; font-size: 15px; color: #A1A1AA">Probá con otra marca o escribinos: muchas unidades entran antes de publicarse.</p>
<div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 8px">
<button type="button" class="chip" data-limpiar style="height: 44px; padding: 0 20px; border-radius: 999px; border: 1px solid #3A3A40; background: transparent; color: #F5F5F4; font-size: 15px; font-weight: 600">Limpiar filtros</button>
<a class="btn-red" href="<%= site.whatsapp.link('Hola JH Motors, estoy buscando un auto y no lo encontré en el catálogo.') %>" target="_blank" rel="noopener" style="display: inline-flex; align-items: center; height: 44px; padding: 0 20px; border-radius: 999px; font-size: 15px; font-weight: 700">Preguntar por WhatsApp</a>
</div>
</div>
</section>

<section id="financiacion" style="background: #111113; border-top: 1px solid #1E1E22; border-bottom: 1px solid #1E1E22; scroll-margin-top: 70px">
<div style="max-width: 1280px; margin: 0 auto; padding: 88px 24px; display: flex; flex-wrap: wrap; align-items: center; gap: 48px">
<div style="flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #FF3B30">Financiación</p>
<h2 style="margin: 0; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.02; font-weight: 800; font-stretch: 115%; text-wrap: balance">Llevátelo hoy y pagalo a tu ritmo.</h2>
<p style="margin: 0; max-width: 460px; font-size: 17px; line-height: 1.55; color: #B4B4BC">Te armamos el plan según el auto que elijas. Escribinos con la referencia del auto y te pasamos la cuota.</p>
<a class="btn-red" href="<%= site.whatsapp.link('Hola JH Motors, quiero consultar por financiación.') %>" target="_blank" rel="noopener" style="align-self: flex-start; display: inline-flex; align-items: center; gap: 9px; height: 52px; padding: 0 24px; border-radius: 999px; font-size: 16px; font-weight: 700">
<%- icon.wa(18) %>
Consultar financiación
</a>
</div>
<div style="flex: 1 1 520px; min-width: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 16px">
<div style="background: #0A0A0B; border: 1px solid #26262B; border-radius: 18px; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="font-size: 44px; line-height: 1; font-weight: 800; font-stretch: 118%">100%</span>
<span style="font-size: 18px; font-weight: 700">Financiamos el auto completo</span>
<span style="font-size: 15px; line-height: 1.5; color: #A1A1AA">Sin entrega inicial. Consultá requisitos y condiciones.</span>
</div>
<div style="background: #0A0A0B; border: 1px solid #26262B; border-radius: 18px; padding: 28px; display: flex; flex-direction: column; gap: 12px">
<span style="font-size: 44px; line-height: 1; font-weight: 800; font-stretch: 118%; color: #FF3B30">36</span>
<span style="font-size: 18px; font-weight: 700">Cuotas fijas, financiación propia</span>
<span style="font-size: 15px; line-height: 1.5; color: #A1A1AA">Entregás el 50% y el saldo lo pagás en hasta 36 cuotas fijas, directo con nosotros.</span>
</div>
</div>
</div>
</section>

<section style="max-width: 1280px; margin: 0 auto; padding: 96px 24px">
<div style="border: 1px solid #2A2A2F; border-radius: 24px; padding: clamp(32px, 4vw, 56px); background: #0E0E10; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 32px">
<div style="flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 14px">
<p style="margin: 0; font-size: 13px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #FF3B30">Ventas y consignaciones</p>
<h2 style="margin: 0; font-size: clamp(32px, 3.6vw, 48px); line-height: 1.02; font-weight: 800; font-stretch: 115%">¿Querés vender tu auto?</h2>
<p style="margin: 0; max-width: 560px; font-size: 17px; line-height: 1.55; color: #B4B4BC">Completá los datos de tu auto y nos llegan directo por WhatsApp. Te ayudamos a venderlo o lo consignamos en nuestro salón.</p>
</div>
<a class="btn-red" href="/vende-tu-auto" style="display: inline-flex; align-items: center; gap: 10px; height: 56px; padding: 0 28px; border-radius: 999px; font-size: 17px; font-weight: 700">
Ofrecer mi auto
<%- icon.arrowRight(18) %>
</a>
</div>
</section>
</main>

<footer id="contacto" style="background: #070708; border-top: 1px solid #1E1E22">
<div style="max-width: 1280px; margin: 0 auto; padding: 56px 24px 32px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 32px">
<div style="display: flex; flex-direction: column; gap: 12px">
<div style="display: flex; align-items: baseline; gap: 7px">
<span style="font-family: 'Bodoni Moda', Didot, 'Times New Roman', serif; font-weight: 700; font-size: 32px; line-height: 1; color: #FFFFFF">JH</span>
<span style="font-stretch: 115%; font-weight: 800; font-size: 19px; line-height: 1; letter-spacing: 0.03em; color: #FF3B30">MOTORS</span>
</div>
<p style="margin: 0; font-size: 15px; line-height: 1.5; color: #A1A1AA">Automotora. Ventas, consignaciones y financiación de autos en Toledo y Atlántida.</p>
</div>
<% for (const sede of Object.values(site.sedes)) { %>
<div style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.5">
<span style="font-weight: 700">Local <%= sede.nombre %></span>
<span style="color: #A1A1AA"><%= sede.direccion %></span>
<span style="color: #A1A1AA"><%= sede.horario %></span>
<a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(sede.mapsQuery) %>" target="_blank" rel="noopener">Cómo llegar</a>
</div>
<% } %>
<div style="display: flex; flex-direction: column; gap: 8px; font-size: 15px; line-height: 1.5">
<span style="font-weight: 700">Contacto</span>
<a href="<%= site.whatsapp.link() %>" target="_blank" rel="noopener">WhatsApp <%= site.whatsapp.display %></a>
<a href="<%= site.instagram.url %>" target="_blank" rel="noopener">Instagram @<%= site.instagram.user %></a>
<a href="/vende-tu-auto">Vendé tu auto</a>
</div>
</div>
<div style="max-width: 1280px; margin: 0 auto; padding: 20px 24px 36px; border-top: 1px solid #1A1A1D; font-size: 13px; color: #8A8A93">© <%= new Date().getFullYear() %> JH Motors. Precios en dólares, sujetos a cambio sin previo aviso.</div>
</footer>
</div>
<script src="/js/catalogo.js?v=<%= assetVersion %>" defer></script>
</body>
</html>

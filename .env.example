# Copiá este archivo como .env y completá los valores.

# Puerto donde corre la web.
PORT=3000

# Dirección pública de la web, sin barra al final (se usa en los links que van por WhatsApp,
# el sitemap y Google). En local: http://localhost:3000
SITE_URL=http://localhost:3000

# WhatsApp que recibe los mensajes: 598 + celular sin el 0, sin espacios.
# Pruebas: 091 969 322 -> 59891969322
# Producción (el de JH Motors): 099 571 202 -> 59899571202
WHATSAPP_NUMBER=59891969322

# Acceso al panel /admin (una sola cuenta).
ADMIN_USER=admin
ADMIN_PASSWORD=cambiame-por-una-contraseña-larga

# Texto largo y al azar para firmar la sesión del admin. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Carpeta donde se guardan la base de datos y las fotos (opcional; por defecto ./data).
# DATA_DIR=/var/data/jhmotors
